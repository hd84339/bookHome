<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
            <h2 class="fw-black mb-4 text-center">Edit Listing</h2>
            
            <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="needs-validation" novalidate>
                
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="title" placeholder="Enter title" name="listing[title]" value="<%= listing.title %>" required>
                    <label for="title">Title</label>
                </div>

                <div class="form-floating mb-3">
                    <textarea class="form-control" id="description" placeholder="Enter description" name="listing[description]" style="height: 100px" required><%= listing.description %></textarea>
                    <label for="description">Description</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="url" class="form-control" id="image" placeholder="Image URL" name="listing[image][url]" value="<%= listing.image.url %>" required>
                    <label for="image">Image URL</label>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="number" class="form-control" id="price" placeholder="Price" name="listing[price]" value="<%= listing.price %>" required>
                            <label for="price">Price (₹)</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="location" placeholder="Location" name="listing[location]" value="<%= listing.location %>" required>
                            <label for="location">Location</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="country" placeholder="Country" name="listing[country]" value="<%= listing.country %>" required>
                            <label for="country">Country</label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold mt-4 shadow-sm">Update Listing</button>
            </form>
        </div>
    </div>
</div>
<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h2 class="fw-bold mb-4"><%= listing.title %></h2>
        
        <div class="mb-4">
            <img src="<%= listing.image.url %>" alt="listing image" class="show-img">
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <h4 class="fw-bold mb-3">About this place</h4>
            <p class="text-muted fs-5"><%= listing.description %></p>
            <hr class="my-4">
            <div class="row g-4">
                <div class="col-6">
                    <h5 class="fw-bold"><i class="bi bi-tag-fill text-primary me-2"></i>Price</h5>
                    <p class="fs-5 mb-0">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : listing.price %> / night</p>
                </div>
                <div class="col-6">
                    <h5 class="fw-bold"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Location</h5>
                    <p class="fs-5 mb-0"><%= listing.location %>, <%= listing.country %></p>
                </div>
            </div>
        </div>

        <div class="d-flex gap-3 mt-4">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">Edit Listing</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-bold shadow-sm">Delete Listing</button>
            </form>
        </div>
    </div>
</div>
